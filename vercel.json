{
  "version": 2,
  "regions": [
    "iad1"
  ],
  "builds": [
    {
      "src": "Core/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.9"
      }
    }
  ],
  "routes": [
    {
      "src": "/media/(.*)",
      "dest": "Core/wsgi.py",
      "headers": {
        "cache-control": "public, max-age=2592000, s-maxage=31536000, stale-while-revalidate=86400"
      }
    },
    {
      "src": "/static/(.*)",
      "dest": "Core/wsgi.py",
      "headers": {
        "cache-control": "public, max-age=2592000, s-maxage=31536000, stale-while-revalidate=86400"
      }
    },
    {
      "src": "/(.*)",
      "dest": "Core/wsgi.py"
    }
  ]
}
